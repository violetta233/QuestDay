<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="QuestDay.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:QuestDay.Views"
    x:Name="ThisShell"
    Shell.FlyoutBehavior="Disabled"
    Title="QuestDay">

    <Shell.Resources>
        <ControlTemplate x:Key="FloatingTabBarTemplate">
            <Grid>
                <ContentPresenter VerticalOptions="Fill" HorizontalOptions="Fill"/>
                <Grid IgnoreSafeArea="True" VerticalOptions="End">
                    <Border 
                        Margin="10,0,10,25"
                        HeightRequest="65"
                        HorizontalOptions="Fill"
                        BackgroundColor="White"
                        VerticalOptions="End"
                        Stroke="#FFCD72" 
                        StrokeThickness="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <FlexLayout JustifyContent="SpaceAround" AlignItems="Center">
                            <Border Padding="10"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                 Value="MainPage">
                                        <Setter Property="BackgroundColor" Value="#FFF3DC" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <ImageButton Source="home.png" 
                                             BackgroundColor="Transparent"
                                             Clicked="OnNavClicked" 
                                             CommandParameter="MainPage"
                                             HeightRequest="30" 
                                             Opacity="0.55"
                                             WidthRequest="30">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton"
                                                     Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                     Value="MainPage">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                            </Border>

                            <Border Padding="10"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                 Value="ListPage">
                                        <Setter Property="BackgroundColor" Value="#FFF3DC" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <ImageButton Source="file.png" 
                                             BackgroundColor="Transparent"
                                             Clicked="OnNavClicked" 
                                             CommandParameter="ListPage"
                                             HeightRequest="30" 
                                             Opacity="0.55"
                                             WidthRequest="30">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton"
                                                     Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                     Value="ListPage">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                            </Border>

                            <Border Padding="10"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                 Value="AddPage">
                                        <Setter Property="BackgroundColor" Value="#FFF3DC" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <ImageButton Source="plus.png" 
                                             BackgroundColor="Transparent"
                                             Clicked="OnNavClicked" 
                                             CommandParameter="AddPage"
                                             HeightRequest="30" 
                                             Opacity="0.55"
                                             WidthRequest="30">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton"
                                                     Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                     Value="AddPage">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                            </Border>

                            <Border Padding="10"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                 Value="SettingPage">
                                        <Setter Property="BackgroundColor" Value="#FFF3DC" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <ImageButton Source="setting.png" 
                                             BackgroundColor="Transparent"
                                             Clicked="OnNavClicked" 
                                             CommandParameter="SettingPage"
                                             HeightRequest="30" 
                                             Opacity="0.55"
                                             WidthRequest="30">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton"
                                                     Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                     Value="SettingPage">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                            </Border>

                            <Border Padding="10"
                                    BackgroundColor="Transparent"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                 Value="userPage">
                                        <Setter Property="BackgroundColor" Value="#FFF3DC" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <ImageButton Source="profile.png" 
                                             BackgroundColor="Transparent"
                                             Clicked="OnNavClicked" 
                                             CommandParameter="userPage"
                                             HeightRequest="30" 
                                             Opacity="0.55"
                                             WidthRequest="30">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton"
                                                     Binding="{Binding Source={x:Reference ThisShell}, Path=CurrentRoute}"
                                                     Value="userPage">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                            </Border>
                        </FlexLayout>
                    </Border>
                </Grid>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
            <Setter Property="ControlTemplate" Value="{StaticResource FloatingTabBarTemplate}" />
            <Setter Property="Shell.TabBarIsVisible" Value="False" />
        </Style>
    </Shell.Resources>

    <ShellContent
        Icon="home.png"
        Route="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}" />

    <ShellContent
        Icon="file.png"
        Route="ListPage"
        ContentTemplate="{DataTemplate local:ListPage}" />

    <ShellContent
        Icon="plus.png"
        Route="AddPage"
        ContentTemplate="{DataTemplate local:AddPage}"/>

    <ShellContent
        Icon="setting.png"
        Route="SettingPage"
        ContentTemplate="{DataTemplate local:SettingPage}" />

    <ShellContent
        Icon="profile.png"
        Route="userPage"
        ContentTemplate="{DataTemplate local:userPage}" />
</Shell>
