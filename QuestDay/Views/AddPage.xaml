<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestDay.Views.AddPage"
             xmlns:viewmodels="clr-namespace:QuestDay.ViewModels"
             xmlns:converters="clr-namespace:QuestDay.Converters"
             BackgroundColor="#FFFBF6">

    <ContentPage.Resources>
        <converters:DaySelectedToColorConverter x:Key="DaySelectedToColorConverter" />
        <converters:DaySelectedToTextColorConverter x:Key="DaySelectedToTextColorConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:EnabledToColorConverter x:Key="EnabledToColorConverter" />
        <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20,20,20,100">
                <HorizontalStackLayout Spacing="5">
                    <Label Text="Название привычки"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="Montserrat-SemiBold" />
                    <Label Text="*"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="Red"
                           FontFamily="Montserrat-SemiBold" />
                </HorizontalStackLayout>

                <Entry Placeholder="Введите название привычки"
                       FontFamily="Montserrat-SemiBold"
                       Text="{Binding Name}"
                       ClearButtonVisibility="WhileEditing" />
                
                <Label Text="{Binding NameError}"
                       IsVisible="{Binding NameError, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                       TextColor="Red"
                       FontSize="12"
                       FontFamily="Montserrat-SemiBold"
                       Margin="0,-10,0,0" />

                <Label Text="Описание"
                       FontSize="18"
                       FontAttributes="Bold"
                       FontFamily="Montserrat-SemiBold" />
                <Editor Placeholder="Добавьте краткое описание (необязательно)"
                        FontFamily="Montserrat-SemiBold"
                        Text="{Binding Description}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="80" />

                <HorizontalStackLayout Spacing="5" Margin="0,10,0,0">
                    <Label Text="Дни недели"
                           FontFamily="Montserrat-SemiBold"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Start" />
                    <Label Text="*"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Red"
                           FontFamily="Montserrat-SemiBold" />
                </HorizontalStackLayout>

                <CollectionView ItemsSource="{Binding DaysOfWeekSelection.DayOptions}"
                                HorizontalOptions="FillAndExpand">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Horizontal" HorizontalItemSpacing="9" VerticalItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:DayOption">
                            <Frame HasShadow="True" CornerRadius="25" Padding="14"
                                   BackgroundColor="{Binding IsSelected, Converter={StaticResource DaySelectedToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleSelectedCommand}" />
                                </Frame.GestureRecognizers>
                                <Label Text="{Binding Name}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DaySelectedToTextColorConverter}}" />
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding DaysError}"
                       IsVisible="{Binding DaysError, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                       TextColor="Red"
                       FontSize="12"
                       FontFamily="Montserrat-SemiBold"
                       Margin="0,-10,0,0" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#4CAF50"
                                   HorizontalOptions="Center" />

                <Button Text="Сохранить привычку"
                        FontFamily="Montserrat-SemiBold"
                        Command="{Binding SaveHabitCommand}"
                        IsEnabled="{Binding SaveHabitCommand.CanExecute}"
                        BackgroundColor="{Binding SaveHabitCommand.CanExecute, 
                            Converter={StaticResource EnabledToColorConverter}}"
                        TextColor="White"
                        CornerRadius="10"
                        Margin="0,20,0,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding SaveHabitCommand.CanExecute}"
                                     Value="False">
                            <Setter Property="Command" Value="{Binding ShowValidationTooltipCommand}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding SaveHabitCommand.CanExecute}"
                                     Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Label Text="* — обязательные поля"
                       FontSize="11"
                       TextColor="Gray"
                       FontFamily="Montserrat-SemiBold"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
