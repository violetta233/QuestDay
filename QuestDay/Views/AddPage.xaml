<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestDay.Views.AddPage"
             xmlns:viewmodels="clr-namespace:QuestDay.ViewModels"
             xmlns:converters="clr-namespace:QuestDay.Converters"
             BackgroundColor="#FFFBF6"
             ControlTemplate="{x:Null}">

    <ContentPage.Resources>
        <converters:DaySelectedToColorConverter x:Key="DaySelectedToColorConverter" />
        <converters:DaySelectedToTextColorConverter x:Key="DaySelectedToTextColorConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:EnabledToColorConverter x:Key="EnabledToColorConverter" />
        <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />

        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>

        <Style TargetType="Editor">
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20,20,20,100">

                <HorizontalStackLayout Spacing="5">
                    <Label Text="Название привычки"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontFamily="Montserrat-SemiBold"
                           TextColor="Black" />
                    <Label Text="*"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="Red"
                           FontFamily="Montserrat-SemiBold" />
                </HorizontalStackLayout>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Entry Grid.Row="0"
                           Placeholder="Введите название привычки"
                           FontFamily="Montserrat-SemiBold"
                           Text="{Binding Name}"
                           ClearButtonVisibility="WhileEditing"
                           TextColor="Black"
                           PlaceholderColor="#999999"
                           FontSize="16" />

                    <BoxView Grid.Row="1"
                             HeightRequest="1"
                             BackgroundColor="#CCCCCC"
                             Margin="0,5,0,0" />
                </Grid>

                <Label Text="{Binding NameError}"
                       IsVisible="{Binding NameError, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                       TextColor="Red"
                       FontSize="12"
                       FontFamily="Montserrat-SemiBold"
                       Margin="0,-10,0,0" />

                <Label Text="Описание"
                       FontSize="18"
                       FontAttributes="Bold"
                       FontFamily="Montserrat-SemiBold"
                       TextColor="Black"
                       Margin="0,10,0,0" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Editor Grid.Row="0"
                            Placeholder="Добавьте краткое описание (необязательно)"
                            FontFamily="Montserrat-SemiBold"
                            Text="{Binding Description}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            TextColor="Black"
                            PlaceholderColor="#999999"
                            FontSize="14" />

                    <BoxView Grid.Row="1"
                             HeightRequest="1"
                             BackgroundColor="#CCCCCC"
                             Margin="0,5,0,0" />
                </Grid>

                <HorizontalStackLayout Spacing="5" Margin="0,10,0,0">
                    <Label Text="Дни недели"
                           FontFamily="Montserrat-SemiBold"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Start"
                           TextColor="Black" />
                    <Label Text="*"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="Red"
                           FontFamily="Montserrat-SemiBold" />
                </HorizontalStackLayout>

                <CollectionView ItemsSource="{Binding DaysOfWeekSelection.DayOptions}"
                                HorizontalOptions="FillAndExpand">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Horizontal" 
                                         HorizontalItemSpacing="9" 
                                         VerticalItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:DayOption">
                            <Frame HasShadow="True" 
                                   CornerRadius="25" 
                                   Padding="14,10"
                                   BackgroundColor="{Binding IsSelected, Converter={StaticResource DaySelectedToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleSelectedCommand}" />
                                </Frame.GestureRecognizers>
                                <Label Text="{Binding Name}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{Binding IsSelected, Converter={StaticResource DaySelectedToTextColorConverter}}" />
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding DaysError}"
                       IsVisible="{Binding DaysError, Converter={StaticResource StringNotNullOrEmptyConverter}}"
                       TextColor="Red"
                       FontSize="12"
                       FontFamily="Montserrat-SemiBold"
                       Margin="0,-10,0,0" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#4CAF50"
                                   HorizontalOptions="Center" />

                <Button Text="Сохранить привычку"
                        FontFamily="Montserrat-SemiBold"
                        Command="{Binding SaveHabitCommand}"
                        IsEnabled="{Binding SaveHabitCommand.CanExecute}"
                        CornerRadius="10"
                        Margin="0,20,0,0"
                        HeightRequest="50"
                        FontSize="16">
                    <Button.Triggers>

                        <DataTrigger TargetType="Button"
                                     Binding="{Binding SaveHabitCommand.CanExecute}"
                                     Value="True">
                            <Setter Property="BackgroundColor" Value="#4CAF50"/>
                            <Setter Property="TextColor" Value="White"/>
                        </DataTrigger>

                        <DataTrigger TargetType="Button"
                                     Binding="{Binding SaveHabitCommand.CanExecute}"
                                     Value="False">
                            <Setter Property="BackgroundColor" Value="#E0E0E0"/>
                            <Setter Property="TextColor" Value="#999999"/>
                            <Setter Property="Command" Value="{Binding ShowValidationTooltipCommand}"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Label Text="* — обязательные поля"
                       FontSize="11"
                       TextColor="Gray"
                       FontFamily="Montserrat-SemiBold"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid IgnoreSafeArea="True" VerticalOptions="End">
            <Border 
                Margin="10,0,10,25"
                HeightRequest="65"
                HorizontalOptions="Fill"
                BackgroundColor="#FFFBF6"
                Stroke="#FFCD72" 
                StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <FlexLayout JustifyContent="SpaceAround" AlignItems="Center">
                    <ImageButton Source="home.png" 
                                 Clicked="OnNavClicked" 
                                 CommandParameter="MainPage"
                                 HeightRequest="30" 
                                 WidthRequest="30"/>
                    <ImageButton Source="file.png" 
                                 Clicked="OnNavClicked" 
                                 CommandParameter="ListPage"
                                 HeightRequest="30" 
                                 WidthRequest="30"/>
                    <ImageButton Source="plus.png" 
                                 Clicked="OnNavClicked" 
                                 CommandParameter="AddPage"
                                 HeightRequest="30" 
                                 WidthRequest="30"/>
                    <ImageButton Source="setting.png" 
                                 Clicked="OnNavClicked" 
                                 CommandParameter="SettingPage"
                                 HeightRequest="30" 
                                 WidthRequest="30"/>
                    <ImageButton Source="profile.png" 
                                 Clicked="OnNavClicked" 
                                 CommandParameter="userPage"
                                 HeightRequest="30" 
                                 WidthRequest="30"/>
                </FlexLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>