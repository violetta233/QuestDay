<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestDay.Views.BeautyPopup"
             x:Name="PopupView"
             IsVisible="False">

    <Grid BackgroundColor="#CC000000"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">

        <Frame BackgroundColor="White"
               CornerRadius="30"
               Padding="25"
               Margin="30"
               VerticalOptions="Center"
               HasShadow="True">

            <Grid>
                <VerticalStackLayout x:Name="ContentLayout" Spacing="15" IsVisible="True">
                    <Label x:Name="IconLabel"
                           Text="✅"
                           FontSize="55"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontFamily="Montserrat-SemiBold"/>

                    <Label x:Name="TitleLabel"
                           Text="Подтверждение"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           FontFamily="Montserrat-SemiBold"
                           TextColor="#2C3E50"/>

                    <Label x:Name="MessageLabel"
                           Text="Вы уверены?"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           FontFamily="Montserrat-SemiBold"
                           TextColor="#7F8C8D"
                           LineBreakMode="WordWrap"/>

                    <HorizontalStackLayout Spacing="15" 
                                           Margin="0,10,0,0" 
                                           HorizontalOptions="Center">
                        <Button x:Name="CancelBtn"
                                Text="Нет"
                                BackgroundColor="#ECF0F1"
                                TextColor="#7F8C8D"
                                CornerRadius="15"
                                FontFamily="Montserrat-SemiBold"
                                HeightRequest="50"
                                WidthRequest="120"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                        <Button x:Name="ConfirmBtn"
                                Text="Да"
                                BackgroundColor="#F68063"
                                TextColor="White"
                                CornerRadius="15"
                                FontFamily="Montserrat-SemiBold"
                                HeightRequest="50"
                                WidthRequest="120"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="LoadingLayout" 
                                     Spacing="15" 
                                     IsVisible="False"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="True"
                                       Color="#F68063"
                                       HeightRequest="50"
                                       WidthRequest="50"/>
                    <Label Text="Сохранение..."
                           FontSize="14"
                           HorizontalOptions="Center"
                           FontFamily="Montserrat-SemiBold"
                           TextColor="#7F8C8D"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentView>