<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuestDay.Views.SettingPage"
             BackgroundColor="#FFFBF6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="20,10,20,140">

                <Label Text="Настройки"
                       HorizontalOptions="Start"
                       Margin="10,20,0,10"
                       FontFamily="Montserrat-SemiBold"
                       TextColor="Black"
                       FontSize="22" />

                <!-- Поле для имени -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16,12"
                       HasShadow="False"
                       BorderColor="#E8E0D8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Мое имя"
                               FontSize="16"
                               TextColor="#333333"
                               VerticalOptions="Center" />
                        <Entry x:Name="NameEntry"
                               Grid.Column="1"
                               Placeholder="Имя"
                               FontSize="16"
                               TextColor="#333333"
                               PlaceholderColor="#CCCCCC"
                               BackgroundColor="Transparent"
                               HorizontalOptions="End"
                               WidthRequest="150"
                               TextChanged="OnNameTextChanged" />
                    </Grid>
                </Frame>

                <!-- Ежедневное напоминание -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="False"
                       BorderColor="#E8E0D8">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="Ежедневное напоминание"
                                   FontSize="16"
                                   TextColor="#333333"
                                   VerticalOptions="Center" />
                            <TimePicker x:Name="TimePicker"
Grid.Column="1"
Format="HH:mm"
FontSize="16"
WidthRequest="100"
HorizontalOptions="End"
BackgroundColor="Transparent"
TextColor="#333333"/>
                            <Switch x:Name="ReminderSwitch" 
                                    Grid.Column="2"
                                    IsToggled="True"
                                    OnColor="#E0E0E0"
                                    ThumbColor="#A7DFAF"
                                    Toggled="OnReminderSwitchToggled" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="Текст напоминания:"
                                   FontSize="14"
                                   TextColor="#666666"
                                   VerticalOptions="Center" />
                            <Entry x:Name="ReminderTextEntry"
                                   Grid.Column="1"
                                   Placeholder="Введите текст напоминания"
                                   FontSize="14"
                                   TextColor="#333333"
                                   PlaceholderColor="#CCCCCC"
                                   BackgroundColor="Transparent"
                                   TextChanged="OnReminderTextEntryTextChanged" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Звук -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16,12"
                       HasShadow="False"
                       BorderColor="#E8E0D8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Звук"
                               FontSize="16"
                               TextColor="#333333"
                               VerticalOptions="Center" />
                        <Switch x:Name="SoundSwitch" 
                                Grid.Column="1"
                                IsToggled="True"
                                OnColor="#E0E0E0"
                                ThumbColor="#A7DFAF"
                                Toggled="OnSoundSwitchToggled" />
                    </Grid>
                </Frame>

                <!-- Цитаты -->
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16,12"
                       HasShadow="False"
                       BorderColor="#E8E0D8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Цитаты"
                               FontSize="16"
                               TextColor="#333333"
                               VerticalOptions="Center" />
                        <Switch x:Name="QuoteSwitch" 
                                Grid.Column="1"
                                IsToggled="True"
                                OnColor="#E0E0E0"
                                ThumbColor="#A7DFAF"
                                Toggled="OnQuoteSwitchToggled" />
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <Image Source="rabbitsetting.png"
               Grid.Row="0"
               HorizontalOptions="End"
               VerticalOptions="End"
               Margin="0,0,20,40"
               WidthRequest="300"
               HeightRequest="300"/>
    </Grid>
</ContentPage>