<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:QuestDay.Views"
             x:Class="QuestDay.Views.userPage"
             x:DataType="local:userPage"
             BackgroundColor="#F5ECE4">

    <ContentPage.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#FFFDF9"
                                      Offset="0.0" />
                        <GradientStop Color="#F7EBDD"
                                      Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="TextColor" Value="#4C382F" />
            <Setter Property="BorderColor" Value="#D9BFAE" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="FontFamily" Value="Montserrat-SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="HeightRequest" Value="72" />
        </Style>

        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#D8B39B" />
            <Setter Property="TextColor" Value="#4B3429" />
            <Setter Property="BorderColor" Value="#BF9277" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontFamily" Value="Montserrat-SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#3A8E6049"
                            Offset="0,3"
                            Radius="10"
                            Opacity="0.28" />
                </Setter.Value>
            </Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#D8B39B" />
                                <Setter Property="BorderColor" Value="#BF9277" />
                                <Setter Property="TextColor" Value="#4B3429" />
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#E5C5B0" />
                                <Setter Property="BorderColor" Value="#C7997D" />
                                <Setter Property="TextColor" Value="#422B21" />
                                <Setter Property="Scale" Value="1.03" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#C79E84" />
                                <Setter Property="BorderColor" Value="#AD7F66" />
                                <Setter Property="Scale" Value="0.98" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#E7DBD2" />
                                <Setter Property="BorderColor" Value="#D8C4B7" />
                                <Setter Property="TextColor" Value="#9C877A" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Image Source="habit_home_base.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid Padding="16,22,16,108"
              ColumnDefinitions="148,*"
              ColumnSpacing="20">

            <VerticalStackLayout Grid.Column="0"
                                 Spacing="14"
                                 VerticalOptions="Center"
                                 ZIndex="2">
                <Border x:Name="HatCategoryButton"
                        Stroke="#D9BFAE"
                        StrokeThickness="2"
                        BackgroundColor="#FDF8F2"
                        ClassId="category"
                        Padding="10"
                        HeightRequest="126">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#FFFDF9" Offset="0.0" />
                            <GradientStop Color="#F7EBDD" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHatButtonTapped" />
                        <PointerGestureRecognizer PointerEntered="OnCategoryPointerEntered"
                                                 PointerExited="OnCategoryPointerExited" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="6">
                        <Image Source="headdress.png"
                               HeightRequest="62"
                               WidthRequest="62"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label Grid.Row="1"
                               Text="Головные уборы"
                               FontFamily="Montserrat-SemiBold"
                               FontSize="13"
                               TextColor="#4C382F"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                    </Grid>
                </Border>

                <Border x:Name="TopCategoryButton"
                        Stroke="#D9BFAE"
                        StrokeThickness="2"
                        BackgroundColor="#FDF8F2"
                        ClassId="category"
                        Padding="10"
                        HeightRequest="126">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#FFFDF9" Offset="0.0" />
                            <GradientStop Color="#F7EBDD" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTopButtonTapped" />
                        <PointerGestureRecognizer PointerEntered="OnCategoryPointerEntered"
                                                 PointerExited="OnCategoryPointerExited" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="6">
                        <Image Source="shirt.png"
                               HeightRequest="62"
                               WidthRequest="62"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label Grid.Row="1"
                               Text="Одежда"
                               FontFamily="Montserrat-SemiBold"
                               FontSize="13"
                               TextColor="#4C382F"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="PaletteCategoryButton"
                        Stroke="#D9BFAE"
                        StrokeThickness="2"
                        BackgroundColor="#FDF8F2"
                        ClassId="category"
                        Padding="10"
                        HeightRequest="126">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#FFFDF9" Offset="0.0" />
                            <GradientStop Color="#F7EBDD" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPaletteButtonTapped" />
                        <PointerGestureRecognizer PointerEntered="OnCategoryPointerEntered"
                                                 PointerExited="OnCategoryPointerExited" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="6">
                        <Image Source="palette.png"
                               HeightRequest="62"
                               WidthRequest="62"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label Grid.Row="1"
                               Text="Окраска"
                               FontFamily="Montserrat-SemiBold"
                               FontSize="13"
                               TextColor="#4C382F"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Grid Grid.Column="1">
                <Grid x:Name="RabbitPreview"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      WidthRequest="400"
                      HeightRequest="530"
                      InputTransparent="True">
                    <Image Source="rabbit_warm.png"
                           Aspect="AspectFit"
                           WidthRequest="385"
                           HeightRequest="485"
                           HorizontalOptions="Center"
                           VerticalOptions="End" />

                    <Image Source="{Binding ActiveRabbitVariantImage}"
                           Aspect="AspectFit"
                           WidthRequest="385"
                           HeightRequest="485"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           IsVisible="{Binding IsAlternateRabbitVisible}" />

                    <Image Source="{Binding ActiveTopImage}"
                           Aspect="AspectFit"
                           WidthRequest="385"
                           HeightRequest="485"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           IsVisible="{Binding HasTopImage}" />

                    <Image Source="{Binding ActiveHatImage}"
                           Aspect="AspectFit"
                           WidthRequest="228"
                           HeightRequest="228"
                           Margin="0,40,0,0"
                           HorizontalOptions="Center"
                           VerticalOptions="Start"
                           IsVisible="{Binding HasHatImage}" />
                </Grid>

                <Border x:Name="SelectionPanel"
                        WidthRequest="320"
                        Padding="18"
                        Stroke="#D9BFAE"
                        StrokeThickness="1.5"
                        HorizontalOptions="End"
                        VerticalOptions="Fill"
                        Margin="6,0,0,0"
                        IsVisible="False"
                        TranslationX="360"
                        ZIndex="3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#FAF2EA"
                                          Offset="0.0" />
                            <GradientStop Color="#F1E2D4"
                                          Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Button x:Name="BackButton"
                                    Text="Назад"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Clicked="OnBackToPreviewClicked">
                                <Button.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEntered="OnPanelButtonPointerEntered"
                                                             PointerExited="OnPanelButtonPointerExited" />
                                </Button.GestureRecognizers>
                            </Button>

                            <Label Grid.Column="1"
                                   Text="{Binding ActiveCategoryTitle}"
                                   VerticalTextAlignment="Center"
                                   FontFamily="Montserrat-SemiBold"
                                   FontSize="20"
                                   TextColor="#3D2B24" />
                        </Grid>

                        <ScrollView Grid.Row="1"
                                    HeightRequest="560"
                                    Margin="0,6,0,0"
                                    VerticalScrollBarVisibility="Never">
                            <VerticalStackLayout Spacing="16">
                                <Grid HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      WidthRequest="226"
                                      HeightRequest="280"
                                      InputTransparent="True">
                                    <Image Source="rabbit_warm.png"
                                           Aspect="AspectFit"
                                           WidthRequest="224"
                                           HeightRequest="272"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End" />

                                    <Image Source="{Binding ActiveRabbitVariantImage}"
                                           Aspect="AspectFit"
                                           WidthRequest="224"
                                           HeightRequest="272"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End"
                                           IsVisible="{Binding IsAlternateRabbitVisible}" />

                                    <Image Source="{Binding ActiveTopImage}"
                                           Aspect="AspectFit"
                                           WidthRequest="224"
                                           HeightRequest="272"
                                           HorizontalOptions="Center"
                                           VerticalOptions="End"
                                           IsVisible="{Binding HasTopImage}" />

                                    <Image Source="{Binding ActiveHatImage}"
                                           Aspect="AspectFit"
                                           WidthRequest="106"
                                           HeightRequest="106"
                                           Margin="0,18,0,0"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Start"
                                           IsVisible="{Binding HasHatImage}" />
                                </Grid>

                                <Grid  x:Name="HatCardsSection"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="12"
                                      RowSpacing="12">
                                    <Border Style="{x:Null}"
                                            Stroke="#BF9277"
                                            StrokeThickness="1.6"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 20">
                                        <Border.Background>
                                            <SolidColorBrush Color="#E8CCB8" />
                                        </Border.Background>
                                        <Grid HeightRequest="174">
                                            <Border BackgroundColor="#F1F1F1"
                                                    Stroke="#D8C4B7"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 18" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Stroke="#BF9277"
                                            StrokeThickness="1.6"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 20">
                                        <Border.Background>
                                            <SolidColorBrush Color="#E8CCB8" />
                                        </Border.Background>
                                        <Grid HeightRequest="174">
                                            <Border BackgroundColor="#F1F1F1"
                                                    Stroke="#D8C4B7"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 18" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Stroke="#BF9277"
                                            StrokeThickness="1.6"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 20">
                                        <Border.Background>
                                            <SolidColorBrush Color="#E8CCB8" />
                                        </Border.Background>
                                        <Grid HeightRequest="174">
                                            <Border BackgroundColor="#F1F1F1"
                                                    Stroke="#D8C4B7"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 18" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Grid.Column="1"
                                            Stroke="#BF9277"
                                            StrokeThickness="1.6"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 20">
                                        <Border.Background>
                                            <SolidColorBrush Color="#E8CCB8" />
                                        </Border.Background>
                                        <Grid HeightRequest="174">
                                            <Border BackgroundColor="#F1F1F1"
                                                    Stroke="#D8C4B7"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 18" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid x:Name="TopCardsSection"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="12"
                                      RowSpacing="12">
                                    <Border BackgroundColor="#E8CCB8"
                                            Stroke="{Binding OverallsCardBorderColor}"
                                            StrokeThickness="{Binding OverallsCardBorderWidth}"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 20">
                                        <Border.Background>
                                            <SolidColorBrush Color="#E8CCB8" />
                                        </Border.Background>
                                        <Grid RowDefinitions="*,Auto"
                                              RowSpacing="10"
                                              HeightRequest="182">
                                            <Border BackgroundColor="#E7E7E7"
                                                    Stroke="#CFCFCF"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 18">
                                                <Image Source="overalls_skin1_blue.png"
                                                       Aspect="AspectFit"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       HeightRequest="108"
                                                       WidthRequest="108" />
                                            </Border>
                                            <Button x:Name="OverallsActionButton"
                                                    Grid.Row="1"
                                                    Text="Надеть"
                                                    FontSize="11"
                                                    HeightRequest="42"
                                                    Padding="6,4"
                                                    CornerRadius="18"
                                                    BorderWidth="2"
                                                    FontFamily="Montserrat-SemiBold"
                                                    TextTransform="None"
                                                    Clicked="OnOverallsClicked" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#E8CCB8"
                                            Stroke="{Binding TShirtCardBorderColor}"
                                            StrokeThickness="{Binding TShirtCardBorderWidth}"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 20">
                                        <Border.Background>
                                            <SolidColorBrush Color="#E8CCB8" />
                                        </Border.Background>
                                        <Grid RowDefinitions="*,Auto"
                                              RowSpacing="10"
                                              HeightRequest="182">
                                            <Border BackgroundColor="#E7E7E7"
                                                    Stroke="#CFCFCF"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 18">
                                                <Image Source="t_shirt_mechmat.png"
                                                       Aspect="AspectFit"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       HeightRequest="108"
                                                       WidthRequest="108" />
                                            </Border>
                                            <Button x:Name="TShirtActionButton"
                                                    Grid.Row="1"
                                                    Text="Надеть"
                                                    FontSize="11"
                                                    HeightRequest="42"
                                                    Padding="6,4"
                                                    CornerRadius="18"
                                                    BorderWidth="2"
                                                    FontFamily="Montserrat-SemiBold"
                                                    TextTransform="None"
                                                    Clicked="OnTShirtClicked" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1"
                                            BackgroundColor="#E8CCB8"
                                            Stroke="{Binding BeltCardBorderColor}"
                                            StrokeThickness="{Binding BeltCardBorderWidth}"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 20">
                                        <Border.Background>
                                            <SolidColorBrush Color="#E8CCB8" />
                                        </Border.Background>
                                        <Grid RowDefinitions="*,Auto"
                                              RowSpacing="10"
                                              HeightRequest="182">
                                            <Border BackgroundColor="#E7E7E7"
                                                    Stroke="#CFCFCF"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 18">
                                                <Image Source="overalls_skin1_blue.png"
                                                       Aspect="AspectFit"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       HeightRequest="108"
                                                       WidthRequest="108" />
                                            </Border>
                                            <Button x:Name="BeltActionButton"
                                                    Grid.Row="1"
                                                    Text="Надеть"
                                                    FontSize="11"
                                                    HeightRequest="42"
                                                    Padding="6,4"
                                                    CornerRadius="18"
                                                    BorderWidth="2"
                                                    FontFamily="Montserrat-SemiBold"
                                                    TextTransform="None"
                                                    Clicked="OnBeltClicked" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid x:Name="PaletteCardsSection"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="12"
                                      RowSpacing="12">
                                    <Border BackgroundColor="#E8CCB8"
                                            Stroke="{Binding PaletteCardBorderColor}"
                                            StrokeThickness="{Binding PaletteCardBorderWidth}"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 20">
                                        <Border.Background>
                                            <SolidColorBrush Color="#E8CCB8" />
                                        </Border.Background>
                                        <Grid RowDefinitions="*,Auto"
                                              RowSpacing="10"
                                              HeightRequest="182">
                                            <Border BackgroundColor="#E7E7E7"
                                                    Stroke="#CFCFCF"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 18">
                                                <Image Source="rabbit_1_warm_bg_skintone.png"
                                                       Aspect="AspectFit"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       HeightRequest="112"
                                                       WidthRequest="112" />
                                            </Border>
                                            <Button x:Name="PaletteActionButton"
                                                    Grid.Row="1"
                                                    Text="Надеть"
                                                    FontSize="11"
                                                    HeightRequest="42"
                                                    Padding="6,4"
                                                    CornerRadius="18"
                                                    BorderWidth="2"
                                                    FontFamily="Montserrat-SemiBold"
                                                    TextTransform="None"
                                                    Clicked="OnPaletteVariantClicked" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
