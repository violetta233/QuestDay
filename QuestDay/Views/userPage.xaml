<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:QuestDay.Views"
             x:Class="QuestDay.Views.userPage"
             x:DataType="local:userPage"
             BackgroundColor="#F5ECE4">

    <ContentPage.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#FFFDF9"
                                      Offset="0.0" />
                        <GradientStop Color="#F7EBDD"
                                      Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="TextColor" Value="#4C382F" />
            <Setter Property="BorderColor" Value="#D9BFAE" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="FontFamily" Value="Montserrat-SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="HeightRequest" Value="72" />
        </Style>

        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#D8B39B" />
            <Setter Property="TextColor" Value="#4B3429" />
            <Setter Property="BorderColor" Value="#BF9277" />
            <Setter Property="BorderWidth" Value="2" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontFamily" Value="Montserrat-SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#3A8E6049"
                            Offset="0,3"
                            Radius="10"
                            Opacity="0.28" />
                </Setter.Value>
            </Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#D8B39B" />
                                <Setter Property="BorderColor" Value="#BF9277" />
                                <Setter Property="TextColor" Value="#4B3429" />
                                <Setter Property="Scale" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#E5C5B0" />
                                <Setter Property="BorderColor" Value="#C7997D" />
                                <Setter Property="TextColor" Value="#422B21" />
                                <Setter Property="Scale" Value="1.03" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#C79E84" />
                                <Setter Property="BorderColor" Value="#AD7F66" />
                                <Setter Property="Scale" Value="0.98" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#E7DBD2" />
                                <Setter Property="BorderColor" Value="#D8C4B7" />
                                <Setter Property="TextColor" Value="#9C877A" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Image Source="habit_home_base.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid Padding="16,22,16,108"
              ColumnDefinitions="148,*"
              ColumnSpacing="20">

            <VerticalStackLayout Grid.Column="0"
                                 Spacing="14"
                                 VerticalOptions="Center"
                                 ZIndex="2">
                <Border x:Name="HatCategoryButton"
                        Stroke="#D9BFAE"
                        StrokeThickness="2"
                        BackgroundColor="#FDF8F2"
                        ClassId="category"
                        Padding="10"
                        HeightRequest="126">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#FFFDF9" Offset="0.0" />
                            <GradientStop Color="#F7EBDD" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHatButtonTapped" />
                        <PointerGestureRecognizer PointerEntered="OnCategoryPointerEntered"
                                                 PointerExited="OnCategoryPointerExited" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="6">
                        <Image Source="headdress.png"
                               HeightRequest="62"
                               WidthRequest="62"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label Grid.Row="1"
                               Text="Головные уборы"
                               FontFamily="Montserrat-SemiBold"
                               FontSize="13"
                               TextColor="#4C382F"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                    </Grid>
                </Border>

                <Border x:Name="TopCategoryButton"
                        Stroke="#D9BFAE"
                        StrokeThickness="2"
                        BackgroundColor="#FDF8F2"
                        ClassId="category"
                        Padding="10"
                        HeightRequest="126">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#FFFDF9" Offset="0.0" />
                            <GradientStop Color="#F7EBDD" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTopButtonTapped" />
                        <PointerGestureRecognizer PointerEntered="OnCategoryPointerEntered"
                                                 PointerExited="OnCategoryPointerExited" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="6">
                        <Image Source="shirt.png"
                               HeightRequest="62"
                               WidthRequest="62"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label Grid.Row="1"
                               Text="Одежда"
                               FontFamily="Montserrat-SemiBold"
                               FontSize="13"
                               TextColor="#4C382F"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="PaletteCategoryButton"
                        Stroke="#D9BFAE"
                        StrokeThickness="2"
                        BackgroundColor="#FDF8F2"
                        ClassId="category"
                        Padding="10"
                        HeightRequest="126">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#FFFDF9" Offset="0.0" />
                            <GradientStop Color="#F7EBDD" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPaletteButtonTapped" />
                        <PointerGestureRecognizer PointerEntered="OnCategoryPointerEntered"
                                                 PointerExited="OnCategoryPointerExited" />
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="6">
                        <Image Source="palette.png"
                               HeightRequest="62"
                               WidthRequest="62"
                               Aspect="AspectFit"
                               HorizontalOptions="Center" />
                        <Label Grid.Row="1"
                               Text="Окраска"
                               FontFamily="Montserrat-SemiBold"
                               FontSize="13"
                               TextColor="#4C382F"
                               HorizontalTextAlignment="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Grid Grid.Column="1">
                <Grid x:Name="RabbitPreview"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      WidthRequest="400"
                      HeightRequest="530"
                      InputTransparent="True">
                    <Image Source="rabbit_warm.png"
                           Aspect="AspectFit"
                           WidthRequest="385"
                           HeightRequest="485"
                           HorizontalOptions="Center"
                           VerticalOptions="End" />

                    <Image Source="{Binding ActiveRabbitVariantImage}"
                           Aspect="AspectFit"
                           WidthRequest="385"
                           HeightRequest="485"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           IsVisible="{Binding IsAlternateRabbitVisible}" />

                    <Image Source="{Binding ActiveTopImage}"
                           Aspect="AspectFit"
                           WidthRequest="385"
                           HeightRequest="485"
                           HorizontalOptions="Center"
                           VerticalOptions="End"
                           IsVisible="{Binding HasTopImage}" />

                    <Image Source="{Binding ActiveHatImage}"
                           Aspect="AspectFit"
                           WidthRequest="228"
                           HeightRequest="228"
                           Margin="0,40,0,0"
                           HorizontalOptions="Center"
                           VerticalOptions="Start"
                           IsVisible="{Binding HasHatImage}" />
                </Grid>

                <Border x:Name="SelectionPanel"
                        WidthRequest="320"
                        Padding="18"
                        Stroke="#D9BFAE"
                        StrokeThickness="1.5"
                        HorizontalOptions="End"
                        VerticalOptions="Fill"
                        Margin="6,0,0,0"
                        IsVisible="False"
                        TranslationX="360"
                        ZIndex="3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,1">
                            <GradientStop Color="#FAF2EA"
                                          Offset="0.0" />
                            <GradientStop Color="#F1E2D4"
                                          Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30" />
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto,Auto,*"
                          RowSpacing="14">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Button x:Name="BackButton"
                                    Text="Назад"
                                    Style="{StaticResource PanelButtonStyle}"
                                    Clicked="OnBackToPreviewClicked">
                                <Button.GestureRecognizers>
                                    <PointerGestureRecognizer PointerEntered="OnPanelButtonPointerEntered"
                                                             PointerExited="OnPanelButtonPointerExited" />
                                </Button.GestureRecognizers>
                            </Button>

                            <Label Grid.Column="1"
                                   Text="{Binding ActiveCategoryTitle}"
                                   VerticalTextAlignment="Center"
                                   FontFamily="Montserrat-SemiBold"
                                   FontSize="20"
                                   TextColor="#3D2B24" />
                        </Grid>

                        <Grid Grid.Row="1"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              WidthRequest="210"
                              HeightRequest="250"
                              InputTransparent="True">
                            <Image Source="rabbit_warm.png"
                                   Aspect="AspectFit"
                                   WidthRequest="190"
                                   HeightRequest="235"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End" />

                            <Image Source="{Binding ActiveRabbitVariantImage}"
                                   Aspect="AspectFit"
                                   WidthRequest="190"
                                   HeightRequest="235"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   IsVisible="{Binding IsAlternateRabbitVisible}" />

                            <Image Source="{Binding ActiveTopImage}"
                                   Aspect="AspectFit"
                                   WidthRequest="190"
                                   HeightRequest="235"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   IsVisible="{Binding HasTopImage}" />

                            <Image Source="{Binding ActiveHatImage}"
                                   Aspect="AspectFit"
                                   WidthRequest="116"
                                   HeightRequest="116"
                                   Margin="0,16,0,0"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Start"
                                   IsVisible="{Binding HasHatImage}" />
                        </Grid>

                        <ScrollView Grid.Row="2"
                                    HeightRequest="344"
                                    VerticalOptions="Start">
                            <FlexLayout BindableLayout.ItemsSource="{Binding ActiveSlots}"
                                        HorizontalOptions="Center"
                                        MaximumWidthRequest="250"
                                        Wrap="Wrap"
                                        Direction="Row"
                                        JustifyContent="SpaceBetween"
                                        AlignContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:WardrobeSlot">
                                        <Border BackgroundColor="{Binding SlotBackgroundColor}"
                                                Stroke="{Binding SlotBorderColor}"
                                                StrokeThickness="{Binding SlotBorderWidth}"
                                                ClassId="slot"
                                                Margin="0,0,0,14"
                                                HeightRequest="146"
                                                WidthRequest="118"
                                                Padding="8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#2E8A5F47"
                                                        Offset="0,4"
                                                        Radius="10"
                                                        Opacity="0.18" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <PointerGestureRecognizer PointerEntered="OnSlotPointerEntered"
                                                                         PointerExited="OnSlotPointerExited" />
                                            </Border.GestureRecognizers>

                                            <Grid RowDefinitions="*,Auto"
                                                  RowSpacing="8">
                                                <Border BackgroundColor="#FFFDFC"
                                                        Stroke="#D9C2B2"
                                                        StrokeThickness="1.4"
                                                        Padding="8">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16" />
                                                    </Border.StrokeShape>
                                                    <Grid>
                                                        <Label Text="{Binding PreviewText}"
                                                               TextColor="{Binding SlotTextColor}"
                                                               FontFamily="Montserrat-SemiBold"
                                                               FontSize="13"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center"
                                                               LineBreakMode="WordWrap"
                                                               MaxLines="3" />
                                                    </Grid>
                                                </Border>

                                                <Button Grid.Row="1"
                                                        Text="{Binding ActionText}"
                                                        Clicked="OnSlotActionClicked"
                                                        BindingContext="{Binding .}"
                                                        BackgroundColor="{Binding ActionBackgroundColor}"
                                                        TextColor="{Binding ActionTextColor}"
                                                        BorderColor="{Binding ActionBorderColor}"
                                                        BorderWidth="1.4"
                                                        CornerRadius="16"
                                                        HeightRequest="36"
                                                        FontFamily="Montserrat-SemiBold"
                                                        FontSize="12"
                                                        Shadow="{x:Null}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
